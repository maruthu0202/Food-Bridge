# FoodBridge Environment Configuration

# Flask Application Mode (development / production / testing)
FLASK_ENV=development

# Flask Secret Key for Session Security
SECRET_KEY=dev-secret-key-change-in-production-12345

# Database URL (Default: SQLite for local dev. Use MySQL/Cloud SQL in prod)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/food_donation_dev
DATABASE_URL=sqlite:///food_donation_dev.db

# Google Cloud Storage Settings (Optional - uses local folder 'uploads/' if omitted)
# GOOGLE_CLOUD_PROJECT=my-gcp-project-id
# GCS_BUCKET_NAME=my-foodbridge-bucket
